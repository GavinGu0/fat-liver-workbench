# ===== 全部环境变量均为可选：不配置时系统以纯内存演示模式运行 =====
# 存储采用进程内存（零外部依赖），重启后恢复为演示种子数据

# JWT 签名密钥（生产必填，建议 64 位以上随机字符串）
JWT_SECRET=

# Vercel Blob（可选，用于饮食照片/评估报告归档等）。不配置时自动降级为内存存储
BLOB_READ_WRITE_TOKEN=

# Edge Config（可选，存放评估模板等全局只读配置）
EDGE_CONFIG=

# 短信服务商密钥（不配置时验证码以 demoCode 形式直接返回，仅供演示）
SMS_KEY=

# Vercel Cron 保护密钥（配置后 Cron 请求需携带 Authorization: Bearer <CRON_SECRET>）
CRON_SECRET=

# 是否在开放 /api/docs 接口文档（默认仅非生产环境开放）
ENABLE_API_DOCS=

# ===== 存储驱动（可选，默认 auto）=====
# auto   — 本地/可写 FS 用 SQLite 文件持久化（data/flwb.db）；Vercel 只读 FS 自动落 /tmp 或降级内存
# memory — 强制进程内存模式（配合 /tmp 快照恢复）
# sqlite — 强制 SQLite（不可用时仍会降级内存并告警）
STORAGE_DRIVER=
# 自定义 SQLite 数据库文件路径（默认 <项目根>/data/flwb.db）
SQLITE_PATH=

# ===== L3 云端快照（Vercel Blob）=====
# 前置：Vercel 控制台 Storage → Create Blob store → 连接本项目（自动注入 BLOB_READ_WRITE_TOKEN）
# 默认行为：连接 Blob store 后，Vercel 上自动启用（无需额外配置）；本地开发自动禁用（防快照污染云端）
# STORAGE_BLOB_SNAPSHOT=false 强制关闭；本地联调可设 true
STORAGE_BLOB_SNAPSHOT=
# 两次上传最小间隔秒（默认 1800；put 属高级操作，Hobby 免费 2000 次/月，30min 节流约 1440 次/月）
STORAGE_BLOB_MIN_INTERVAL_SEC=
