# ===== 全部环境变量均为可选：不配置时系统以演示模式运行（内存存储 + 演示数据，重启后重置） =====
# 生产环境强烈建议配置以下变量以获得持久化能力

# JWT 签名密钥（生产必填，建议 64 位以上随机字符串）
JWT_SECRET=

# Redis（Vercel KV / Upstash）。在 Vercel 控制台 Storage 中添加 Upstash Redis 后自动注入
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 或使用原生 Upstash 变量名
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob（饮食照片/报告归档/审计/备份）。控制台 Storage 添加 Blob 后自动注入
BLOB_READ_WRITE_TOKEN=

# Edge Config（可选，存放评估模板等全局只读配置）
EDGE_CONFIG=

# 短信服务商密钥（不配置时验证码以 demoCode 形式直接返回，仅供演示）
SMS_KEY=

# Vercel Cron 保护密钥（配置后 Cron 请求需携带 Authorization: Bearer <CRON_SECRET>）
CRON_SECRET=

# 是否在开放 /api/docs 接口文档（默认仅非生产环境开放）
ENABLE_API_DOCS=
