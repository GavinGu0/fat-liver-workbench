{
  "name": "fat-liver-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "脂肪肝专病管理工作台 — Vercel Serverless + SQLite/内存混合存储",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @flwb/admin-web && npm run build -w @flwb/patient-h5 && node scripts/copy-landing.js",
    "smoke": "node scripts/smoke.mjs",
    "db:backup": "node scripts/db-backup.mjs backup",
    "db:restore": "node scripts/db-backup.mjs restore",
    "db:list": "node scripts/db-backup.mjs list"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "@vercel/edge-config": "^1.5.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  }
}
